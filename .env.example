# Backblaze B2 — S3-compatible API (required: key id, key, bucket)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Region drives the S3 endpoint (https://s3.<B2_REGION>.backblazeb2.com).
# Optional — defaults to us-west-004 if unset.
B2_REGION=us-west-004

# Optional: public URL base for objects (convenience only — NOT required to
# boot; the app serves media via presigned URLs regardless).
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.your-region.backblazeb2.com

# Where to find these: create a bucket and an application key (Read and Write)
# in the B2 dashboard. keyID -> B2_APPLICATION_KEY_ID, applicationKey ->
# B2_APPLICATION_KEY (shown once), bucket unique name -> B2_BUCKET_NAME.

# --- Depth Anything V2 (local inference — no API key needed) ---
# Model checkpoint. Small is the CPU-friendly default; Base/Large also work.
# DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Small-hf
# Device: auto|cpu|cuda|mps. auto prefers CUDA -> MPS -> CPU, always falling
# back to CPU. Never hard-requires a GPU.
# DEPTH_DEVICE=auto
# Bounded demo run: max images processed per job run.
# DEPTH_MAX_IMAGES_PER_RUN=8

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
